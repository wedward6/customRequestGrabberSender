{
  "manifest_version": 3,
  "name": "Document Request Viewer",
  "version": "1.0",
  "description": "Capture only document (page) network requests.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
